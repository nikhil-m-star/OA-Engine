datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider = "prisma-client-js"
}

model Problem {
  id           Int
  title        String       @db.VarChar(255)
  slug         String       @id @db.VarChar(255)
  difficulty   String       @db.VarChar(50)
  tags         String[]
  description  String
  constraints  String[]
  examples     Json
  follow_up    String?
  starter_code Json
  companies    String[]     @default([])
  test_cases   Json         @default("[]")
  created_at   DateTime     @default(now()) @db.Timestamp
  created_by   String?      @db.VarChar(255)
  submissions  Submission[]

  @@map("problems")
}

model Submission {
  id           Int      @id @default(autoincrement())
  user_id      String
  problem_slug String   @db.VarChar(255)
  language     String   @db.VarChar(20)
  status       String   @db.VarChar(30)
  runtime_ms   Int?
  submitted_at DateTime @default(now()) @db.Timestamp
  problem      Problem  @relation(fields: [problem_slug], references: [slug])

  @@index([user_id], map: "idx_submissions_user")
  @@map("submissions")
}
